# ----------------------------------------------------------------------
# Invoice-Gen.net - Hostinger / Apache / LiteSpeed Configuration
# ----------------------------------------------------------------------

# 0. Default Index Document
DirectoryIndex index.html

# 1. Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1a. Canonical Domain: Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.invoice-gen\.net$ [NC]
  RewriteRule ^(.*)$ https://invoice-gen.net/$1 [R=301,L]

  # 1b. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://invoice-gen.net%{REQUEST_URI} [R=301,L]

  # 1c. 301 Redirect legacy /index.html to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 1d. 301 Redirect legacy tool URLs directly to canonical /tools/*
  RewriteRule ^pdf-to-jpg(\.html)?$ /tools/pdf-to-jpg [R=301,L]
  RewriteRule ^jpg-to-pdf(\.html)?$ /tools/jpg-to-pdf [R=301,L]
  RewriteRule ^pdf-merger(\.html)?$ /tools/pdf-merger [R=301,L]
  RewriteRule ^pdf-splitter(\.html)?$ /tools/pdf-splitter [R=301,L]
  RewriteRule ^image-compressor(\.html)?$ /tools/image-compressor [R=301,L]
  RewriteRule ^tax-calculator(\.html)?$ /tools/tax-calculator [R=301,L]
  RewriteRule ^payment-calculator(\.html)?$ /tools/payment-calculator [R=301,L]
  RewriteRule ^due-date-calculator(\.html)?$ /tools/due-date-calculator [R=301,L]
  RewriteRule ^currency-converter(\.html)?$ /tools/currency-converter [R=301,L]
  RewriteRule ^pdf-invoice-generator(\.html)?$ /tools/pdf-invoice-generator [R=301,L]
  RewriteRule ^gst-tax-invoice(\.html)?$ /tools/gst-tax-invoice [R=301,L]
  RewriteRule ^gst-invoice-generator(\.html)?$ /tools/gst-tax-invoice [R=301,L]
  RewriteRule ^invoice-number-generator(\.html)?$ /tools/invoice-number-generator [R=301,L]
  RewriteRule ^payment-link(\.html)?$ /tools/payment-link [R=301,L]
  RewriteRule ^free-invoice-generator(\.html)?$ /tools/invoice-generator [R=301,L]
  RewriteRule ^invoice-generator-for-freelancers(\.html)?$ /tools/freelancer-invoice [R=301,L]
  RewriteRule ^cloud-file-storage(\.html)?$ /tools/cloud-file-storage [R=301,L]
  RewriteRule ^blog-post(\.html)?$ /blog [R=301,L]

  # 1e. 301 Redirect any remaining legacy /page.html to /page
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP/ [NC]
  RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

  # 1f. Sitemap rewrites
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^sitemap$ sitemap.html [L]

  # 1g. Tool Route Aliases (Internal Clean Serving)
  RewriteRule ^tools/invoice-generator/?$ free-invoice-generator.html [L]
  RewriteRule ^tools/pdf-invoice-generator/?$ pdf-invoice-generator.html [L]
  RewriteRule ^tools/gst-tax-invoice/?$ gst-tax-invoice.html [L]
  RewriteRule ^tools/freelancer-invoice/?$ invoice-generator-for-freelancers.html [L]
  RewriteRule ^tools/invoice-number-generator/?$ invoice-number-generator.html [L]
  RewriteRule ^tools/pdf-to-jpg/?$ pdf-to-jpg.html [L]
  RewriteRule ^tools/jpg-to-pdf/?$ jpg-to-pdf.html [L]
  RewriteRule ^tools/image-compressor/?$ image-compressor.html [L]
  RewriteRule ^tools/pdf-merger/?$ pdf-merger.html [L]
  RewriteRule ^tools/pdf-splitter/?$ pdf-splitter.html [L]
  RewriteRule ^tools/tax-calculator/?$ tax-calculator.html [L]
  RewriteRule ^tools/payment-calculator/?$ payment-calculator.html [L]
  RewriteRule ^tools/due-date-calculator/?$ due-date-calculator.html [L]
  RewriteRule ^tools/currency-converter/?$ currency-converter.html [L]
  RewriteRule ^tools/online-payments/?$ payments.html [L]
  RewriteRule ^tools/payment-link/?$ payment-link.html [L]
  RewriteRule ^tools/cloud-file-storage/?$ cloud-file-storage.html [L]
  RewriteRule ^cloud/?$ files.html [L]

  # 1h. Fallback asset rewrites for subpaths
  RewriteRule ^tools/css/(.*)$ css/$1 [L]
  RewriteRule ^tools/js/(.*)$ js/$1 [L]
  RewriteRule ^tools/assets/(.*)$ assets/$1 [L]

  # 1i. Clean HTML URLs internal rewrite
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# MIME Types for XML & XSL Stylesheets
AddType application/xml .xml
AddType text/xml .xml
AddType application/xslt+xml .xsl


# 2. Custom 404 Error Page
ErrorDocument 404 /404.html

# 3. Gzip Compression for Ultra Fast Page Loads
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# 4. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Icons
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# 5. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
